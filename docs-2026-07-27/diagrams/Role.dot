// Diagram for Role
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		ITSAgentThing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">ITSAgentThing</TD></TR></TABLE>> URL="../ITSAgentThing" margin=0]
	}
	Role [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Role</TD></TR><TR><TD ALIGN="LEFT">cdm1:hasName : rdf:langString [1..*]¹</TD></TR></TABLE>> URL="../Role" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
	}
	Role -> ITSAgentThing [arrowhead=onormal style=solid]
	Role_uniqueLang_note [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><I>¹ Limited to one rdf:langString value per language</I></TD></TR></TABLE>> margin=0]
	Role -> Role_uniqueLang_note [style=invis]
}
